@inproceedings{tamsal2026adaptation,
  abbr={AACL Findings},
  title={Adaptation, Not Algorithm: LoRA and Full Fine-Tuning Show Comparable Black-Box Jailbreak Degradation in Five Open-Weight LLMs},
  author={Tamsal, Taleef and Rusert, Jonathan},
  booktitle={Findings of the Association for Computational Linguistics: AACL-IJCNLP 2026},
  year={2026},
  note={Accepted},
  abstract={We fine-tune five open-weight instruction models (Gemma-2-9B-IT, Llama-3.1-8B-Instruct, Phi-4, Qwen2.5-14B-Instruct, and Qwen3-4B-Instruct-2507) with LoRA, QLoRA, and full fine-tuning, and compare them with the unmodified base model and a 4-bit base. Across black-box, white-box, and multi-turn jailbreaks on HarmBench and JailbreakBench, scored by three automated evaluators checked against 750 doubly annotated human samples, benign fine-tuning raises black-box attack success by similar amounts whichever method is used. Under a ±5 pp equivalence bound fixed before training, LoRA and full fine-tuning are equivalent (TOST p = 0.014), QLoRA is more variable, and 4-bit quantization alone shows no meaningful degradation. Evaluator choice changes the conclusions: GPT-4o-mini's false-positive rate on human-consensus safe outputs is 45.7%, against 8.6% for the HarmBench classifier.},
  code={https://github.com/Taleef7/adaptation-not-algorithm},
  bibtex_show={true},
  selected={true}
}

@inproceedings{tamsal2026judge,
  abbr={NeurIPS WS},
  title={Your Judge Is a Confound: Evaluator and Attack Choice Distort Jailbreak-Safety Measurement for Fine-Tuned LLMs},
  author={Tamsal, Taleef and Rusert, Jonathan},
  booktitle={First Workshop on Reliable Evaluation for Language Models (JUDGe), NeurIPS 2026},
  year={2026},
  note={Non-archival. Also accepted at AdvML-Frontiers × CoTMA, COLM 2026.},
  award={Accepted for oral presentation at JUDGe @ NeurIPS 2026.},
  award_name={Oral},
  abstract={An empirical study showing how evaluator and attack choice can distort jailbreak-safety measurement for fine-tuned language models. Evaluator choice can change the conclusion as much as the adaptation method: even stronger GPT-5.6 judge configurations over-flag 21.5–29.9% of safe completions, and identical outputs receive different labels on 3–15% of repeat evaluations.},
  code={https://github.com/Taleef7/adaptation-not-algorithm},
  selected={true}
}

